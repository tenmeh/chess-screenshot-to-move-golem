# Keep the build context small and reproducible.
.git
.github
.Rproj.user
*.Rproj
renv/library
renv/staging
renv/local
renv/cellar
renv/sandbox

# renv.lock IS used by the Dockerfile (renv::restore() as a one-shot,
# build-time installer - see the comment there), so it is deliberately not
# excluded here. .Rprofile and renv/activate.R are what auto-activate renv as
# a live project on every Rscript call; the image never does that, so they
# stay excluded - copying them in would just invite the exact
# `library(chessvision)` breakage renv's project isolation caused before.
.Rprofile
renv/activate.R
.Rhistory
.RData
.Ruserdata
dev
data-raw
check
*.tar.gz
*.Rcheck
