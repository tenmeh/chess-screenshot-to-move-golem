# Keep the build context small and reproducible.
.git
.github
.Rproj.user
*.Rproj
renv/library
renv/staging
renv/local
renv/cellar
renv/sandbox

# renv is for local dev reproducibility only. The image installs its R
# dependencies explicitly via install2.r in the Dockerfile; .Rprofile would
# auto-activate renv on every Rscript call during the build and reset
# .libPaths() away from the site-library that R CMD INSTALL just populated,
# breaking `library(chessvision)` in the very next RUN step.
.Rprofile
renv.lock
renv/activate.R
.Rhistory
.RData
.Ruserdata
dev
data-raw
check
*.tar.gz
*.Rcheck
